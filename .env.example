# À ajouter dans Cloudflare Pages > Settings > Variables and Secrets.

# Clé Steam Web API — à définir comme Secret.
# Génération : https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# SteamID64 du profil public — variable Text, pas un secret.
STEAM_ID=

# Token de bot Discord — à définir comme Secret dans Cloudflare Pages.
# Crée et gère le bot dans le portail développeur : https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Clé fortnite-api.com — à définir comme Secret si les statistiques Fortnite sont souhaitées.
# Crée une clé dans le tableau de bord : https://dash.fortnite-api.com/
FORTNITE_API_KEY=

# Epic Account ID associé au compte Fortnite — variable Text, pas un secret.
FORTNITE_ACCOUNT_ID=

# PSN_NPSSO, EPIC_TOKEN et ROCKSTAR_SESSION ne sont volontairement pas utilisés :
# les endpoints privés/non documentés sont trop fragiles pour une intégration sûre.
